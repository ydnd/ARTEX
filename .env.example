# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
# 使用自行构建的审计版时设置 ARTEX_IMAGE=artex-audited，ARTEX_TAG=local。
ARTEX_IMAGE=autumn27/artex
POSTGRES_USER=artex
# 使用 openssl rand -hex 32 生成独立密码；未填写时 Compose 拒绝启动。
POSTGRES_PASSWORD=
POSTGRES_DB=artex
# 管理界面默认仅监听本机；远程访问先完成初始化，再使用 HTTPS 反向代理。
ARTEX_BIND=127.0.0.1

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
